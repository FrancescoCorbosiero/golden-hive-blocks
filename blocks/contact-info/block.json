{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "golden-hive/contact-info",
    "version": "1.0.0",
    "title": "Contact Info",
    "category": "golden-hive",
    "icon": "location-alt",
    "description": "Informazioni di contatto aziendali con indirizzo, P.IVA, telefono, email e mappa.",
    "keywords": [
        "contatti",
        "indirizzo",
        "info",
        "telefono",
        "email"
    ],
    "textdomain": "golden-hive-blocks",
    "attributes": {
        "title": {
            "type": "string",
            "default": "Vieni a Trovarci"
        },
        "subtitle": {
            "type": "string"
        },
        "address": {
            "type": "string"
        },
        "vat": {
            "type": "string"
        },
        "phone": {
            "type": "string"
        },
        "email": {
            "type": "string"
        },
        "mapUrl": {
            "type": "string",
            "default": ""
        },
        "mapEmbed": {
            "type": "string"
        },
        "clickToLoad": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
