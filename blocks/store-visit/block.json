{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "golden-hive/store-visit",
    "version": "1.0.0",
    "title": "Vieni in negozio",
    "category": "golden-hive",
    "icon": "store",
    "description": "Il negozio fisico in un blocco: aperto o chiuso adesso, orari con il giorno di oggi, indirizzo con indicazioni, WhatsApp e una mappa che si carica al clic.",
    "keywords": [
        "negozio",
        "orari",
        "mappa",
        "indirizzo",
        "indicazioni",
        "boutique"
    ],
    "textdomain": "golden-hive-blocks",
    "attributes": {
        "eyebrow": {
            "type": "string",
            "default": "Il negozio"
        },
        "title": {
            "type": "string",
            "default": "Vieni in negozio"
        },
        "subtitle": {
            "type": "string"
        },
        "address": {
            "type": "string"
        },
        "vat": {
            "type": "string"
        },
        "phone": {
            "type": "string"
        },
        "showWhatsApp": {
            "type": "boolean",
            "default": true
        },
        "whatsappText": {
            "type": "string",
            "default": "Ciao! Vorrei passare in negozio."
        },
        "hours": {
            "type": "array"
        },
        "note": {
            "type": "string"
        },
        "closedOnHolidays": {
            "type": "boolean"
        },
        "closedDates": {
            "type": "string"
        },
        "mapEmbed": {
            "type": "string"
        },
        "mapImage": {
            "type": "string",
            "default": ""
        },
        "mapImageId": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
