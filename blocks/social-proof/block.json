{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "golden-hive/social-proof",
    "version": "2.0.0",
    "title": "Social Proof",
    "category": "golden-hive",
    "icon": "megaphone",
    "description": "Popup con gli acquisti reali degli ultimi giorni (ordini pagati): prodotto, città e da quanto.",
    "keywords": [
        "social",
        "proof",
        "popup",
        "conversione",
        "notifica"
    ],
    "textdomain": "golden-hive-blocks",
    "attributes": {
        "days": {
            "type": "number",
            "default": 14
        },
        "limit": {
            "type": "number",
            "default": 10
        },
        "showCity": {
            "type": "boolean",
            "default": true
        },
        "maxPerVisit": {
            "type": "number",
            "default": 3
        },
        "notifications": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "product": {
                        "type": "string"
                    },
                    "image": {
                        "type": "string"
                    },
                    "imageId": {
                        "type": "number"
                    },
                    "location": {
                        "type": "string"
                    },
                    "time": {
                        "type": "string"
                    }
                }
            },
            "default": []
        },
        "interval": {
            "type": "number",
            "default": 25000
        },
        "initialDelay": {
            "type": "number",
            "default": 8000
        },
        "displayDuration": {
            "type": "number",
            "default": 6000
        },
        "showVerified": {
            "type": "boolean",
            "default": true
        },
        "title": {
            "type": "string",
            "default": "Qualcuno ha appena acquistato"
        }
    },
    "supports": {
        "align": false,
        "html": false,
        "multiple": false
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
