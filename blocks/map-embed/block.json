{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "golden-hive/map-embed",
    "version": "1.0.0",
    "title": "Map Embed",
    "category": "golden-hive",
    "icon": "location",
    "description": "Mappa Google Maps integrata per mostrare la posizione del negozio.",
    "keywords": [
        "mappa",
        "google",
        "maps",
        "posizione",
        "negozio"
    ],
    "textdomain": "golden-hive-blocks",
    "attributes": {
        "embedCode": {
            "type": "string"
        },
        "height": {
            "type": "number",
            "default": 450
        },
        "borderRadius": {
            "type": "number",
            "default": 12
        },
        "clickToLoad": {
            "type": "boolean",
            "default": true
        },
        "address": {
            "type": "string"
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
