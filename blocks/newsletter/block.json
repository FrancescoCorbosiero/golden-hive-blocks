{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "golden-hive/newsletter",
    "version": "1.1.0",
    "title": "Newsletter",
    "category": "golden-hive",
    "icon": "email",
    "description": "Sezione iscrizione newsletter, con gli avvisi \"è arrivata la tua taglia\" (conferma via email).",
    "keywords": [
        "newsletter",
        "email",
        "iscrizione",
        "mailing",
        "subscribe"
    ],
    "textdomain": "golden-hive-blocks",
    "attributes": {
        "title": {
            "type": "string",
            "default": "Resta Connesso"
        },
        "text": {
            "type": "string",
            "default": "Iscriviti per drop esclusivi, early access e news sulle ultime release."
        },
        "placeholder": {
            "type": "string",
            "default": "La tua email"
        },
        "buttonText": {
            "type": "string",
            "default": "Iscriviti"
        },
        "disclaimer": {
            "type": "string",
            "default": "Rispettiamo la tua privacy. Puoi cancellarti in qualsiasi momento."
        },
        "askSize": {
            "type": "boolean",
            "default": true
        },
        "sizeLabel": {
            "type": "string",
            "default": "Avvisami quando arriva la mia taglia"
        },
        "askBrands": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
