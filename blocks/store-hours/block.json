{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "golden-hive/store-hours",
    "version": "1.0.0",
    "title": "Store Hours",
    "category": "golden-hive",
    "icon": "clock",
    "description": "Orari di apertura del negozio con layout elegante.",
    "keywords": [
        "orari",
        "apertura",
        "negozio",
        "hours",
        "opening"
    ],
    "textdomain": "golden-hive-blocks",
    "attributes": {
        "title": {
            "type": "string",
            "default": "Orari di Apertura"
        },
        "hours": {
            "type": "array"
        },
        "note": {
            "type": "string"
        },
        "closedOnHolidays": {
            "type": "boolean"
        },
        "closedDates": {
            "type": "string"
        }
    },
    "supports": {
        "align": [
            "wide"
        ],
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
